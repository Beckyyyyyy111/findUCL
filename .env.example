# Copy this file to .env and fill in what you have. .env is git-ignored: never commit keys.

# Google Gemini (free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Which one answers: gemini or claude. Empty = Gemini if GEMINI_API_KEY is set, otherwise Claude.
AI_PROVIDER=

# Optional: real UCL desk-sensor data (https://uclapi.com)
UCLAPI_TOKEN=
